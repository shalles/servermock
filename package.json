{
  "name": "servermock",
  "version": "3.0.0",
  "description": "not only static server and ajax mock data, support page mock like dynamic page, separation front-end and server. And you can install plugins free",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "servermock": "./dist/src/bin/index.js",
    "sm": "./dist/src/bin/index.js"
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/bin/index.ts",
    "start": "node dist/src/bin/index.js",
    "test": "node dist/src/bin/index.js start"
  },
  "keywords": [
    "separation",
    "server",
    "mock",
    "mockjson",
    "pagemock"
  ],
  "files": [
    "dist",
    "plugins",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shalles/servermock.git"
  },
  "bugs": {
    "url": "https://github.com/shalles/servermock/issues"
  },
  "author": "shalles <shalles@163.com> (http://shalles.github.io)",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "mockjs": "^1.1.0",
    "urlencode": "^1.1.0",
    "websocket": "^1.0.34"
  },
  "devDependencies": {
    "@types/chalk": "^0.4.31",
    "@types/mockjs": "^1.0.10",
    "@types/node": "^18.11.18",
    "@types/urlencode": "^1.1.2",
    "@types/websocket": "^1.0.10",
    "rimraf": "^3.0.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^4.9.4"
  },
  "type": "commonjs",
  "homepage": "https://github.com/shalles/servermock#readme",
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
